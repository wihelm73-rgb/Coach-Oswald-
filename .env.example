# Copier ce fichier en `.env` (jamais commité — voir .gitignore) et renseigner les vraies valeurs.

# ------------------------------------------------------------------
# GitHub — push automatique du correctif de texte
# ------------------------------------------------------------------
# Personal Access Token GitHub (scope minimal : "repo") utilisé pour le push.
# Créer un token : https://github.com/settings/tokens
GITHUB_TOKEN=

# ------------------------------------------------------------------
# OVH — déploiement de l'archive de production (dossier dist/)
# ------------------------------------------------------------------
# Protocole d'accès à l'hébergement : "ftp" ou "sftp"
OVH_PROTOCOL=ftp

# Hôte OVH (ex: ftp.cluster0XX.hosting.ovh.net ou ssh.cluster0XX.hosting.ovh.net)
OVH_HOST=

# Port (21 pour FTP, 22 pour SFTP par défaut)
OVH_PORT=21

# Identifiants
OVH_USER=
OVH_PASSWORD=

# Chemin distant racine du site sur l'hébergement OVH (ex: /www/ ou /home/xxxxx/www/)
OVH_REMOTE_PATH=
